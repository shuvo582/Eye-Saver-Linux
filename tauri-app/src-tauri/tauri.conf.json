{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Eye Saver",
  "version": "2.48.0",
  "identifier": "com.shuvo.eyesaver",
  "mainBinaryName": "eye-saver",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Eye Saver",
        "width": 920,
        "height": 680,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "visible": true,
        "decorations": true,
        "center": true,
        "backgroundColor": "#0F172A"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; img-src 'self' data:"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "category": "Utility",
    "shortDescription": "Eye break reminders and screen comfort filters",
    "longDescription": "Native Linux remake of Eye Saver: timed breaks, micro pauses, blue filter, dark overlay, idle reset, tray control.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1"
        ]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}